# Copy to .env.docker for Docker Compose (recommended).
#   cp .env.docker.example .env.docker
#
# Compose always overrides DB_HOST / Redis URLs / clears DATABASE_URL so
# containers use the Compose Postgres + Redis, not Neon.

SECRET_KEY=docker-dev-secret-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# Used by the Compose Postgres service (and injected into web/worker/beat)
DB_NAME=invoiceflow
DB_USER=postgres
DB_PASSWORD=postgres
# Host ports (container-internal ports stay 5432 / 6379 / 8000)
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
WEB_HOST_PORT=8000

# Leave empty — Compose forces local DB
DATABASE_URL=

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Optional integrations (paste from your real .env if needed)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEFAULT_TRIAL_DAYS=30
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=False
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEFAULT_FROM_EMAIL=noreply@invoiceflow.com
RESEND_API_KEY=
